# GitHub Personal Access Token (Classic token with repo, gist, notifications, user, project, workflow scopes)
# Generate at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_your_token_here"

# Bridge HTTP Configuration
MCP_PORT=8124
MCP_HOST="127.0.0.1"
MCP_TRANSPORT="streamableHttp"
MCP_PATH="/mcp"

# Custom Node binary path (leave empty to auto-detect via NVM/PATH)
NODE_PATH=""
NPX_PATH=""

# Cloudflare Tunnel Configuration
# Optional: persistent tunnel token if using Cloudflare Zero Trust Named Tunnels
CLOUDFLARE_TUNNEL_TOKEN=""
